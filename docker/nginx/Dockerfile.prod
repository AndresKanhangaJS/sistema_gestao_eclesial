# Nginx de producao: leva os ficheiros estaticos (public/) copiados da imagem
# da app, porque o nginx serve-os directamente sem passar pelo PHP.
ARG APP_IMAGE=sge-app:latest
FROM ${APP_IMAGE} AS app

FROM nginx:stable-alpine
COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
