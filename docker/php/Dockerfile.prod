# Imagem de PRODUCAO do SGE. O codigo fica dentro da imagem (sem bind mount),
# por isso cada deploy = nova imagem. Tres estagios:
#   1. vendor : composer install --no-dev
#   2. assets : vite build (precisa do vendor por causa do @source em app.css)
#   3. app    : php-fpm final, com codigo + vendor + public/build

# --- 1. Dependencias PHP ---
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts \
    --prefer-dist --optimize-autoloader --ignore-platform-reqs

# --- 2. Build do front-end ---
FROM node:22-slim AS assets
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
# npm install (e nao ci): o lockfile pode ter sido gerado noutra plataforma/versao do npm
RUN npm install --no-audit --no-fund
COPY vite.config.js ./
COPY resources ./resources
COPY public ./public
COPY --from=vendor /app/vendor ./vendor
RUN npm run build

# --- 3. Imagem final ---
FROM php:8.3-fpm AS app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libicu-dev \
    default-mysql-client \
    chromium \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Browsershot (spatie/laravel-pdf) precisa do pacote 'puppeteer'; o Chromium
# usado e o do sistema (apt), por isso saltamos o download proprio dele.
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
RUN npm install -g puppeteer

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_mysql mbstring bcmath exif pcntl gd zip intl opcache

RUN pecl install redis && docker-php-ext-enable redis

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.memory_consumption=192'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'upload_max_filesize=100M'; \
        echo 'post_max_size=100M'; \
        echo 'expose_php=0'; \
    } > /usr/local/etc/php/conf.d/prod.ini

WORKDIR /var/www/html

ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} sge || true \
    && useradd -u ${UID} -g ${GID} -m -s /bin/bash sge || true

COPY --chown=sge:sge . .
COPY --chown=sge:sge --from=vendor /app/vendor ./vendor
COPY --chown=sge:sge --from=assets /app/public/build ./public/build

# Estrutura minima de storage/ (o volume nomeado herda isto no 1.o arranque).
RUN mkdir -p storage/app/public storage/app/private storage/logs \
        storage/framework/cache/data storage/framework/sessions storage/framework/views \
        bootstrap/cache \
    && chown -R sge:sge storage bootstrap/cache

USER sge

# Regista os package providers sem tocar na BD (sem .env na imagem).
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative \
    && php artisan package:discover --ansi

EXPOSE 9000
CMD ["php-fpm"]
